<MudPaper Class="pa-2" Style="display: flex; align-items: center; height: 2rem; border-style: inset; border-width: 2px; border-color: #cccccc; padding: 4px;" Elevation="1">
    <MudText Style="flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@Text</MudText>
    <div class="progress my-1" style="width: 150px;display: flex; align-items: center; border: 1px solid gray">
        <div class="progress-bar" style="width:@(ProgressValue)%; background-color: green;">&nbsp;</div>
    </div>
</MudPaper>

@code {
    [Parameter]
    public string Text { get; set; } = "";

    [Parameter]
    public int ProgressValue { get; set; } = 0;
}
